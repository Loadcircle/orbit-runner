; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Orbit Runner"
config/description="Plataformas 3D de movimiento y aventura con un yo-yo cinetico."
config/version="1.0.0"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
config/icon="res://art/ui/icon.png"
boot_splash/bg_color=Color(0.137, 0.42, 0.69, 1)
boot_splash/show_image=false
run/max_fps=60

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

SaveService="*res://scripts/autoload/save_service.gd"
Settings="*res://scripts/autoload/settings.gd"
Progress="*res://scripts/autoload/progress.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[gui]

theme/custom="res://resources/ui/orbit_theme.tres"

[importer_defaults]

scene={
"import_script/path": "res://scripts/tools/toon_post_import.gd"
}

