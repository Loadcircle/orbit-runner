[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.es.translation", "res://localization/strings.en.translation")
locale/fallback="en"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="triggers"
3d_physics/layer_4="hazards"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[shader_globals]

toon_shadow_color={
"type": "color",
"value": Color(0.36, 0.42, 0.8, 1)
}
toon_rim_color={
"type": "color",
"value": Color(1, 0.98, 0.9, 1)
}
toon_band_softness={
"type": "float",
"value": 0.035
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.49, 0.76, 0.94, 1)
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
