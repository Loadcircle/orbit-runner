	b.prompt("HINT_PATROL", 2.5, 5.0)
	b.decorate(2)
	b.plat("L", 3.0)
	b.patrol(-2.5, -0.5, 2.5, -0.5, 3.0)
	b.patrol(2.5, 3.0, -2.5, 3.0, 3.0, 0.5)
	b.mover(2.5, 6.0, "side", 4.0)
	b.mover(2.5, -6.0, "side", 4.0, 0.0, 0.5)
	b.plat("M", 2.5)
	b.checkpoint(0.0)
	b.plat("L", 3.0)
	b.prompt("HINT_LASER", -3.0, 4.0)
	b.laser(1.5)
	b.decorate(1)
	b.turn(90)
	b.plat("L", 3.0)
	b.laser(0.5)
	b.laser(3.5, 2.0, 0.0)
	b.plat("M", 3.0, 1.0)
	b.mover(2.5, 5.0, "up", 3.5)
	b.plat("M", 2.0)
	b.turn(-90)
	b.plat("XL", 3.0)
	b.spinner(0.0, 0.0, 90.0)
	b.checkpoint(5.2)
	_gem_on(0, b.side_plat("S", 6.5, 0.0, 0.0, -1.0))
	b.mover(2.5, 8.0, "fwd", 5.0)
	b.plat("Strip", 2.5)
	b.laser(2.0)
	b.plat("Strip", 3.0, -1.0)
	b.patrol(0.0, -3.0, 0.0, 3.0, 3.0)
	b.plat("L", 3.0)
	b.checkpoint(-2.0)
	b.gem(1, b.local(0.0, 2.0, 4.6))
	b.decorate(2)
	b.turn(90)
	b.plat("M", 3.0)
	b.boost(0.0, 0.0)
	b.plat("L", 7.0, -1.0)
	b.laser(1.0, 1.6, 0.25)
	b.laser(3.5, 1.6, 0.75)
	var low := b.side_plat("S", 3.0, -3.0, 2.0, 1.0)
	_gem_on(2, low, 0.3)
	b.trampoline_at(low.position + b.fwd() * 0.8)
	b.plat("M", 3.0)
	b.decorate(1)
	b.goal(1.0)


