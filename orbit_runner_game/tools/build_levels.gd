# World 1 — Sky Breeze Isles
# ======================================================================
func _breeze_isles() -> void:
	b.start("L")
	b.decorate(3)
	b.plat("M", 2.5)
	b.decorate(1)
	b.plat("S", 2.5, 0.8)
	b.plat("S", 2.5, 0.8)
	b.plat("L", 3.0)
	b.decorate(2)
	b.trampoline(-1.8, 2.5)
	_gem_on(0, b.side_plat("S", 1.0, 5.0, 2.5, -1.0))
	b.plat("Wide", 3.0)
	b.checkpoint(0.0)
	b.decorate(2)
	b.turn(90)
	b.plat("Strip", 2.5, -1.0)
	b.plat("Strip", 2.5)
	_gem_on(1, b.side_plat("S", 5.5, 0.0, 0.0, 1.0))
	b.plat("Wide", 3.0, 0.5)
	# Turn platform: spikes line the left side; the right-hand exit stays clear.
	b.spikes(-1.9, -1.0)
	b.spikes(-1.9, 1.9)
	b.turn(-90)
	b.plat("L", 3.0, 1.0)
	b.decorate(2)
	b.trampoline(0.0, 3.0)
	b.plat("M", 2.5, 4.5)
	b.decorate(1)
	b.plat("S", 3.0, -2.0)
	b.plat("S", 3.0)
	b.gem(2, b.local(0.0, -3.0, 4.6))
	b.plat("L", 3.0)
	b.checkpoint(-2.0)
	b.decorate(2)
	b.plat("M", 3.5, -1.0)
	b.plat("Strip", 3.0, 0.5)
	b.plat("L", 3.0)
	b.decorate(2)
	b.goal(2.5)


