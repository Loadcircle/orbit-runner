func _toy_workshop() -> void:
	b.start("L")
	b.prompt("HINT_SPINNER", 2.5, 5.0)
	b.decorate(2)
	b.plat("L", 3.0)
	b.spinner(0.0, 0.0, 60.0)
	b.plat("M", 3.0)
	b.boost(0.0, 0.0)
	b.prompt("HINT_BOOST")
	b.plat("M", 4.5)
	b.plat("Strip", 3.0)
	b.boost(0.0, -2.0)
	b.plat("L", 6.5, -1.0)
	b.checkpoint(0.0)
	b.prompt("HINT_TIMED", 2.5, 5.0)
	b.decorate(2)
	b.timed(2.5, 0.0, 0.0)
	b.timed(2.5, 0.0, 0.22)
	b.timed(2.5, 0.5, 0.44)
	b.plat("Wide", 2.5)
	b.spinner(0.0, 0.0, 80.0)
	var island := b.side_plat("S", 3.0, 0.0, 0.0, -1.0)
	_gem_on(0, island)
	b.plat("M", 3.0, 1.0)
	b.mover(2.5, 7.0, "fwd", 4.0)
	b.plat("L", 2.5)
	b.checkpoint(-3.0)
	b.spinner(0.0, 1.0, -70.0)
	b.trampoline(2.0, 3.5)
	_gem_on(1, b.side_plat("S", 4.0, 4.0, 3.5, 1.0))
	b.plat("M", 3.0)
	b.boost(0.0, 0.0)
	b.plat("M", 7.0)
	b.timed(2.5, 0.0, 0.0)
	b.timed(2.5, 0.0, 0.22)
	b.gem(2, b.local(0.0, 0.0, 4.5))
	b.plat("L", 2.5)
	b.decorate(2)
	b.goal(2.0)


func _crazy_gears() -> void:
