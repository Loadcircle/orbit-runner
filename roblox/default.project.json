{
  "name": "OrbitRunner",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Levels": {
        "$path": "levels_json"
      },
      "Localization": {
        "$path": "localization"
      }
    },
    "ServerScriptService": {
      "Services": {
        "$path": "src/server/Services"
      },
      "ServerMain": {
        "$path": "src/entry/ServerMain.server.luau"
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "UserChoice",
        "DevTouchMovementMode": "UserChoice",
        "DevComputerCameraMovementMode": "Classic",
        "DevTouchCameraMovementMode": "Classic",
        "CharacterWalkSpeed": 22,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 8
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "ClientMain": {
          "$path": "src/entry/ClientMain.client.luau"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 160
      }
    }
  }
}
